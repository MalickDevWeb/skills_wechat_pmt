page
    /* Tokens de Marque Orange Sonatel */ --ods-orange-primary:  #F16E00;
    --ods-orange-vibrant:  #FF7900;
    --ods-orange-light:  #FFF3E8;
    --ods-orange-pressed:  #D96300;
    /* Neutres */ --ods-black:  #000000;
    --ods-text-main:  #1A1A1A;
    --ods-text-muted:  #666666;
    --ods-border:  #EEEEEE;
    --ods-bg-page:  #F6F6F6;
    --ods-bg-card:  #FFFFFF;
    /* Sémantiques */ --ods-success:  #32C832;
    --ods-warning:  #FFCC00;
    --ods-danger:  #CD3C14;
    background-color:  var(--ods-bg-page);
    color:  var(--ods-text-main);
    font-family:  -apple-system,  BlinkMacSystemFont,  "Segoe UI",  Roboto,  "Helvetica Neue",  Arial,  sans-serif;
    box-sizing:  border-box;
}
/* Boutons Standards Orange Sonatel */ .ods-btn
    display:  flex;
    align-items:  center;
    justify-content:  center;
    height:  96rpx;
    padding:  0 48rpx;
    font-size:  32rpx;
    font-weight:  700;
    border-radius:  9999rpx;
    border:  none;
    box-sizing:  border-box;
}
.ods-btn--primary
    background-color:  #F16E00;
    color:  #FFFFFF;
    box-shadow:  0 8rpx 24rpx rgba(241,  110,  0,  0.28);
}
.ods-btn--pressed
    transform:  scale(0.98);
    background-color:  #D96300;
    opacity:  0.92;
}
.ods-btn--secondary
    background-color:  #FFFFFF;
    color:  #000000;
    border:  2rpx solid #000000;
}
/* Animation Shimmer Universelle 60 FPS */ .shimmer
    background:  linear-gradient(90deg,  #EEEEEE 25%,  #F6F6F6 50%,  #EEEEEE 75%);
    background-size:  200% 100%;
    animation:  shimmerWave 1.5s infinite;
    border-radius:  16rpx;
}
@keyframes shimmerWave
    0%
        background-position:  200% 0;
    }
    100%
        background-position:  -200% 0;
    }
}
