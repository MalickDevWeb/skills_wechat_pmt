{
  "name": "wechat-pmt",
  "version": "2.0.0",
  "description": "Le Référentiel Industriel & Kit d'Architecture pour WeChat Mini-Program (PMT / TCMPP)",
  "main": "scripts/skill-doctor.js",
  "bin": {
    "wechat-pmt": "scripts/cli.js"
  },
  "scripts": {
    "init": "node scripts/cli.js init",
    "lint": "node scripts/skill-doctor.js",
    "doctor": "node scripts/skill-doctor.js",
    "analyze": "node scripts/bundle-doctor.js",
    "lint:duplicates": "node scripts/duplication-doctor.js",
    "lint:guardian": "node scripts/guardian-doctor.js",
    "test:doctor": "node scripts/skill-doctor.js",
    "test:generators": "node scripts/test-generators.js",
    "test:bundle": "node scripts/bundle-doctor.js --self-test",
    "test:guardian": "node scripts/guardian-doctor.js --self-test",
    "test:journal": "node scripts/state-journal.js --self-test",
    "test:merge": "node scripts/merge-doctor.js --self-test",
    "test:harness": "node scripts/test-page-harness.js",
    "test:e2e": "node scripts/e2e-runner.js",
    "quality:wechat": "node scripts/check-wechat-quality.cjs",
    "audit:tcmpp": "node scripts/tcmpp-matrix.js playground",
    "merge:doctor": "node scripts/merge-doctor.js",
    "fix": "node scripts/check-wechat-quality.cjs playground --fix && node scripts/skill-doctor.js --fix",
    "test": "node scripts/skill-doctor.js && node scripts/test-generators.js && node scripts/bundle-doctor.js --self-test && node scripts/guardian-doctor.js --self-test && node scripts/state-journal.js --self-test && node scripts/merge-doctor.js --self-test && node scripts/test-page-harness.js && node scripts/check-wechat-quality.cjs playground && node scripts/tcmpp-matrix.js playground && node scripts/e2e-runner.js",
    "skill:propose": "node scripts/propose-recipe.js",
    "dev:onboard": "node scripts/state-journal.js onboard",
    "dev:enable": "node scripts/state-journal.js enable",
    "dev:disable": "node scripts/state-journal.js disable",
    "task:status": "node scripts/state-journal.js status",
    "task:start": "node scripts/state-journal.js start",
    "task:done": "node scripts/state-journal.js done",
    "hook:install": "node scripts/install-hooks.js",
    "create:page": "node scripts/create-page.js",
    "create:component": "node scripts/create-component.js",
    "create:api": "node scripts/create-api.js"
  },
  "keywords": [
    "wechat",
    "mini-program",
    "tcmpp",
    "maxit",
    "orange-money",
    "skills",
    "architecture"
  ],
  "author": "Malick Dev Web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MalickDevWeb/skills_wechat_pmt.git"
  }
}
