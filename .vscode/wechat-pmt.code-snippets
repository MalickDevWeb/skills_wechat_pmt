  "PMT: Offline-First Outbox Enqueue": {
    "scope": "javascript",
    "prefix": "pmt-outbox",
    "description": "Bloc d'action sécurisé avec file d'attente hors-ligne Outbox en cas d'erreur réseau",
    "body": [
      "try {",
      "  await wx.request({",
      "    url: '${1:https://api.sonatel.com/v1/action}',",
      "    method: 'POST',",
      "    data: ${2:payload}",
      "  });",
      "  wx.showToast({ title: 'Enregistré avec succès !', icon: 'success' });",
      "} catch (err) {",
      "  // En cas d'échec réseau : Enfilement sécurisé dans l'Outbox locale",
      "  Outbox.enqueue('${3:ACTION_TYPE}', ${2:payload});",
      "  wx.showToast({",
      "    title: 'Enregistré hors-ligne. Envoi dès retour réseau.',",
      "    icon: 'none',",
      "    duration: 2500",
      "  });",
      "}"
    ]
  },
  "PMT: WXS i18n Resolver (Wolof & Français)": {
    "scope": "javascript",
    "prefix": "pmt-i18n-wxs",
    "description": "Moteur WXS ES5 de traduction instantanée à 0 ms de latence",
    "body": [
      "var locales = {",
      "  fr: {",
      "    'btn.confirm': 'Confirmer',",
      "    'btn.cancel': 'Annuler',",
      "    'om.balance': 'Solde Orange Money',",
      "    'om.pay': 'Payer'",
      "  },",
      "  wo: {",
      "    'btn.confirm': 'Dëggal',",
      "    'btn.cancel': 'Neenal',",
      "    'om.balance': 'Khaloiss Orange Money',",
      "    'om.pay': 'Feye'",
      "  }",
      "};",
      "",
      "function t(key, lang) {",
      "  var active = lang || 'fr';",
      "  var dict = locales[active] || locales['fr'];",
      "  return dict[key] || key;",
      "}",
      "",
      "module.exports = {",
      "  t: t",
      "};"
    ]
  },
  "PMT: Throttled Scroll Listener (60 FPS)": {
    "scope": "javascript",
    "prefix": "pmt-throttle-scroll",
    "description": "Écouteur de défilement d'écran bridé à 60 FPS pour soulager le thread de rendu",
    "body": [
      "onPageScroll: throttle(function(e) {",
      "  const isScrolled = e.scrollTop > 80;",
      "  if (this.data.isScrolled !== isScrolled) {",
      "    this.setData({ isScrolled: isScrolled });",
      "  }",
      "}, 80)"
    ]
  },
  "PMT: CDP Senegal MSISDN Masking": {
    "scope": "javascript",
    "prefix": "pmt-msisdn-mask",
    "description": "Masque un numéro de téléphone client selon la réglementation CDP Sénégal",
    "body": [
      "function maskMsisdn(msisdn) {",
      "  if (!msisdn || typeof msisdn !== 'string') return '';",
      "  const cleaned = msisdn.replace(/\\s+/g, '').replace(/^\\+221/, '');",
      "  if (cleaned.length < 9) return '***';",
      "  const prefix = cleaned.slice(0, 2);",
      "  const suffix = cleaned.slice(-2);",
      "  return `${prefix} *** ** ${suffix}`;",
      "}"
    ]
  }
}