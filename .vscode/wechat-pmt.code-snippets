  "PMT: Offline-First Outbox Enqueue": {
    "scope": "javascript",
    "prefix": "pmt-outbox",
    "description": "Bloc d'action sécurisé avec file d'attente hors-ligne Outbox en cas d'erreur réseau",
    "body": [
      "try {",
      "  await wx.request({",
      "    url: '${1:https://api.sonatel.com/v1/action}',",
      "    method: 'POST',",
      "    data: ${2:payload}",
      "  });",
      "  wx.showToast({ title: 'Enregistré avec succès !', icon: 'success' });",
      "} catch (err) {",
      "  // En cas d'échec réseau : Enfilement sécurisé dans l'Outbox locale",
