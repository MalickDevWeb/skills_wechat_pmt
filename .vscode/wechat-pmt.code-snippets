  "PMT: WXS i18n Resolver (Wolof & Français)": {
    "scope": "javascript",
    "prefix": "pmt-i18n-wxs",
    "description": "Moteur WXS ES5 de traduction instantanée à 0 ms de latence",
    "body": [
      "var locales = {",
      "  fr: {",
      "    'btn.confirm': 'Confirmer',",
      "    'btn.cancel': 'Annuler',",
      "    'om.balance': 'Solde Orange Money',",
      "    'om.pay': 'Payer'",
      "  },",
      "  wo: {",
      "    'btn.confirm': 'Dëggal',",
      "    'btn.cancel': 'Neenal',",
      "    'om.balance': 'Khaloiss Orange Money',",
      "    'om.pay': 'Feye'",
      "  }",
      "};",
      "",
      "function t(key, lang) {",
      "  var active = lang || 'fr';",
      "  var dict = locales[active] || locales['fr'];",
      "  return dict[key] || key;",
      "}",
      "",
      "module.exports = {",
      "  t: t",
      "};"
    ]
  },
  "PMT: Throttled Scroll Listener (60 FPS)": {
    "scope": "javascript",
    "prefix": "pmt-throttle-scroll",
    "description": "Écouteur de défilement d'écran bridé à 60 FPS pour soulager le thread de rendu",
    "body": [
      "onPageScroll: throttle(function(e) {",
      "  const isScrolled = e.scrollTop > 80;",
      "  if (this.data.isScrolled !== isScrolled) {",
      "    this.setData({ isScrolled: isScrolled });",
      "  }",
      "}, 80)"
    ]
  },
  "PMT: CDP Senegal MSISDN Masking": {
    "scope": "javascript",
    "prefix": "pmt-msisdn-mask",
    "description": "Masque un numéro de téléphone client selon la réglementation CDP Sénégal",
    "body": [
      "function maskMsisdn(msisdn) {",
      "  if (!msisdn || typeof msisdn !== 'string') return '';",
      "  const cleaned = msisdn.replace(/\\s+/g, '').replace(/^\\+221/, '');",
      "  if (cleaned.length < 9) return '***';",
      "  const prefix = cleaned.slice(0, 2);",
      "  const suffix = cleaned.slice(-2);",
      "  return `${prefix} *** ** ${suffix}`;",
      "}"
    ]
  },
  "PMT: Vector PDF Ticket Generator (0 Dependency)": {
    "scope": "javascript",
    "prefix": "pmt-pdf-ticket",
    "description": "Générateur de billet ou facture PDF vectoriel %PDF-1.4 natif sans aucune dépendance npm",
    "body": [
      "export function serializePdfObjects(objects) {",
      "  let pdf = '%PDF-1.4\\n';",
      "  const offsets = [0];",
      "  objects.forEach((obj, idx) => {",
      "    offsets.push(pdf.length);",
      "    pdf += `${idx + 1} 0 obj\\n${obj}\\nendobj\\n`;",
      "  });",
      "  const xref = pdf.length;",
      "  pdf += `xref\\n0 ${objects.length + 1}\\n0000000000 65535 f \\n`;",
      "  offsets.slice(1).forEach((offset) => {",
      "    pdf += `${String(offset).padStart(10, '0')} 00000 n \\n`;",
      "  });",
      "  pdf += `trailer\\n<< /Size ${objects.length + 1} /Root 1 0 R >>\\nstartxref\\n${xref}\\n%%EOF`;",
      "  return pdf;",
      "}"
    ]
  },
  "PMT: Batch Rendering Cascade (Anti IPC Freeze)": {
    "scope": "javascript",
    "prefix": "pmt-batch-render",
    "description": "Rendu par lots de 20 cartes avec attente de callback setData pour éviter de saturer le pont IPC",
    "body": [
      "injectNextBatch() {",
      "  if (this.cursor >= this.rawItems.length) return;",
      "  const nextBatch = this.rawItems.slice(this.cursor, this.cursor + 20);",
      "  const updatePayload = {};",
      "  nextBatch.forEach((item, index) => {",
      "    updatePayload[`${displayedItems}[${this.cursor + index}]`] = item;",
      "  });",
      "  this.cursor += nextBatch.length;",
      "  this.setData(updatePayload, () => {",
      "    if (this.cursor < 40 && this.cursor < this.rawItems.length) {",
      "      this.injectNextBatch();",
      "    }",
      "  });",
      "}"
    ]
  },
  "PMT: Chunked File Uploader (Resumable 1 Mo)": {
    "scope": "javascript",
    "prefix": "pmt-chunk-upload",
    "description": "Téléversement par morceaux (chunks 1 Mo) avec auto-retry 3G/4G et suivi de progression",
    "body": [
      "import { uploadFileInChunks } from '../../utils/helpers/chunkedUploader';",
      "",
      "async uploadLargeDocument(filePath) {",
      "  this.setData({ isUploading: true, uploadProgress: 0 });",
      "  try {",
      "    const token = wx.getStorageSync('auth_token') || '';",
      "    const result = await uploadFileInChunks({",
      "      filePath,",
      "      fileName: '${1:document.pdf}',",
      "      uploadUrl: '${2:https://api.sonatel.sn/v1/upload/chunk}',",
      "      completeUrl: '${3:https://api.sonatel.sn/v1/upload/complete}',",
      "      headers: { Authorization: `Bearer ${token}` },",
      "      onProgress: ({ percent, currentChunk, totalChunks }) => {",
      "        this.setData({ uploadProgress: percent });",
      "      }",
      "    });",
      "    this.setData({ isUploading: false, uploadedUrl: result.fileUrl });",
      "    wx.showToast({ title: 'Téléversement réussi', icon: 'success' });",
      "  } catch (err) {",
      "    this.setData({ isUploading: false });",
      "    wx.showModal({ title: 'Erreur', content: err.message, showCancel: false });",
      "  }",
      "}"
    ]
  },
  "PMT: Encrypted Secure Storage (CDP & Sonatel Compliant)": {
