  "PMT: Resilient WebSocket Service (Heartbeat & Auto Reconnect)": {
    "scope": "javascript",
    "prefix": "pmt-websocket",
    "description": "Connexion WebSocket résiliente avec heartbeat ping/pong, reconnexion progressive et file d'attente sortante",
    "body": [
      "import { webSocketService } from '../../utils/helpers/websocketService';",
      "",
      "onLoad(options) {",
      "  webSocketService.connect('${1:wss://stream.sonatel.sn/v1/live}', {",
      "    headers: { Authorization: `Bearer ${wx.getStorageSync('auth_token')}` },",
      "    heartbeatInterval: 30000",
      "  });",
      "",
      "  this.unsub = webSocketService.on('${2:event_name}', (data) => {",
      "    this.setData({ liveData: data });",
      "  });",
      "},",
      "",
      "onUnload() {",
      "  if (this.unsub) this.unsub();",
      "  webSocketService.disconnect();",
      "}"
    ]
  },
