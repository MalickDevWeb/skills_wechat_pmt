    "prefix": "pmt-secure-storage",
    "description": "Stockage local chiffré transparent avec empreinte matérielle et anti-tampering FNV-1a",
    "body": [
      "import { secureStorage } from '../../utils/helpers/secureStorage';",
      "",
      "// Écriture chiffrée sur la mémoire flash (Data-at-Rest)",
      "secureStorage.set('${1:auth_token}', ${2:tokenValue});",
      "",
      "// Lecture sécurisée avec fallback",
      "const ${1:token} = secureStorage.get('${1:auth_token}', null);",
