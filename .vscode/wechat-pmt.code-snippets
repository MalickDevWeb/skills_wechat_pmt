{
  "PMT: WeChat Page Controller (uiState & Safe Lifecycle)": {
    "scope": "javascript",
    "prefix": "pmt-page-js",
    "description": "Génère un contrôleur de page WeChat avec machine à états uiState et cycle de vie sécurisé",
    "body": [
      "Page({",
      "  data: {",
      "    uiState: 'loading', // 'loading' | 'success' | 'empty' | 'error'",
      "    errorMessage: '',",
      "    items: []",
      "  },",
      "",
      "  async onLoad(options) {",
      "    await this.loadInitialData();",
      "  },",
      "",
      "  async loadInitialData() {",
      "    this.setData({ uiState: 'loading', errorMessage: '' });",
      "    try {",
      "      // TODO: Appel API via BackendAPI",
      "      const items = [];",
      "      this.setData({",
      "        items,",
      "        uiState: items.length > 0 ? 'success' : 'empty'",
      "      });",
      "    } catch (err) {",
      "      console.error('[Page] Erreur de chargement :', err);",
      "      this.setData({",
      "        uiState: 'error',",
      "        errorMessage: err.message || 'Impossible de charger les données.'",
      "      });",
      "    }",
      "  },",
      "",
      "  onRetry() {",
      "    this.loadInitialData();",
      "  },",
      "",
      "  onUnload() {",
      "    // Nettoyage impératif des timers et écouteurs d'événements",
      "  }",
      "});"
    ]
  },
  "PMT: WeChat Page WXML (Safe Area & States)": {
    "scope": "wxml,html",
    "prefix": "pmt-page-wxml",
    "description": "Structure WXML avec machine à états uiState et respect des Safe Areas iPhone",
    "body": [
      "<view class=\"page-container\">",
      "  <!-- État Chargement : Skeletons Shimmer -->",
      "  <block wx:if=\"{{ uiState === 'loading' }}\">",
      "    <view class=\"shimmer skeleton-card\"></view>",
      "    <view class=\"shimmer skeleton-card\"></view>",
      "  </block>",
      "",
      "  <!-- État Succès : Données -->",
      "  <block wx:elif=\"{{ uiState === 'success' }}\">",
      "    <view class=\"content\">",
      "      <view wx:for=\"{{ items }}\" wx:key=\"id\" class=\"item-card\">",
      "        <text class=\"item-title\">{{ item.title }}</text>",
      "      </view>",
      "    </view>",
      "  </block>",
      "",
      "  <!-- État Vide : Empty State -->",
      "  <block wx:elif=\"{{ uiState === 'empty' }}\">",
      "    <view class=\"empty-state\">",
      "      <text class=\"empty-text\">Aucun élément disponible.</text>",
      "    </view>",
      "  </block>",
      "",
      "  <!-- État Erreur : Error Boundary -->",
      "  <block wx:elif=\"{{ uiState === 'error' }}\">",
      "    <view class=\"error-state\">",
      "      <text class=\"error-text\">{{ errorMessage }}</text>",
      "      <button class=\"ods-btn ods-btn--primary\" hover-class=\"ods-btn--pressed\" bindtap=\"onRetry\">",
      "        Réessayer",
      "      </button>",
      "    </view>",
      "  </block>",
      "",
      "  <!-- Espaceur physique Safe Area pour bas d'écran iPhone -->",
      "  <view class=\"safe-area-spacer\"></view>",
      "</view>"
    ]
  },
  "PMT: WXSS BEM & Orange Design System Tokens": {
    "scope": "wxss,css",
    "prefix": "pmt-page-wxss",
    "description": "Feuille de styles WXSS scopée BEM avec Safe Area et boutons Orange Sonatel",
    "body": [
      ".page-container {",
      "  min-height: 100vh;",
      "  background-color: #F6F6F6;",
      "  padding: 32rpx;",
      "  box-sizing: border-box;",
      "}",
      "",
      ".safe-area-spacer {",
      "  height: env(safe-area-inset-bottom, 32rpx);",
      "  width: 100%;",
      "}",
      "",
      "/* Bouton Orange Sonatel Officiel */",
      ".ods-btn {",
      "  display: flex;",
      "  align-items: center;",
      "  justify-content: center;",
      "  height: 96rpx;",
      "  border-radius: 9999rpx;",
      "  font-size: 32rpx;",
      "  font-weight: 700;",
      "  border: none;",
      "}",
      "",
      ".ods-btn--primary {",
      "  background-color: #F16E00;",
      "  color: #FFFFFF;",
      "  box-shadow: 0 8rpx 24rpx rgba(241, 110, 0, 0.28);",
      "}",
      "",
      ".ods-btn--pressed {",
      "  transform: scale(0.98);",
      "  background-color: #D96300;",
      "  opacity: 0.92;",
      "}",
      "",
      "/* Animation Shimmer Wave 60 FPS */",
      ".shimmer {",
      "  background: linear-gradient(90deg, #EEEEEE 25%, #F6F6F6 50%, #EEEEEE 75%);",
      "  background-size: 200% 100%;",
      "  animation: shimmerWave 1.5s infinite;",
      "  border-radius: 16rpx;",
      "}",
      "",
      "@keyframes shimmerWave {",
      "  0% { background-position: 200% 0; }",
      "  100% { background-position: -200% 0; }",
      "}"
    ]
  },
  "PMT: Orange Money Solde Pill (Signature ODS)": {
    "scope": "wxml,html",
    "prefix": "pmt-om-pill",
    "description": "Composant pilule de solde Orange Money avec masquage de confidentialité",
    "body": [
      "<view class=\"om-pill\">",
      "  <view class=\"om-pill__header\">",
      "    <text class=\"om-pill__title\">Orange Money</text>",
      "  </view>",
      "  <view class=\"om-pill__amount-row\" bindtap=\"toggleMask\">",
